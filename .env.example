# Copy to `.env` (gitignored) and fill in. The schema that validates these is src/env.js.
# `next build` fails on missing/invalid values; SKIP_ENV_VALIDATION=1 skips the check (CI, Docker).

# --- Database (Postgres) ----------------------------------------------------
# Neon: DATABASE_URL is the pooled (-pooler) URL the app uses at runtime;
# DATABASE_URL_UNPOOLED is the direct URL that `prisma migrate` needs (prisma.config.ts prefers it).
# Locally both can be the same Postgres, and DATABASE_URL_UNPOOLED can be left out.
DATABASE_URL="postgresql://user:password@localhost:5432/streamapp"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, no trailing slash. Must be https in production: the Google OAuth
# redirect URI is derived from it (<BETTER_AUTH_URL>/api/auth/callback/google) and has to be
# registered, character for character, in the Google Cloud OAuth client.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (S3 API) -------------------------------------------------
# The bucket needs a CORS rule allowing PUT + the Content-Type header from every origin you
# upload from (http://localhost:3000, your production domain).
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name
# Optional: public URL of the bucket (custom domain / r2.dev). When set, artwork is served from it;
# when unset, artwork goes through presigned redirects.
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# --- Tests only (never point these at a real database: they are wiped) ------
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/streamapp_test"
