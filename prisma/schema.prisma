generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum MediaKind {
  AUDIO
  IMAGE
  WAVEFORM
}

enum MediaStatus {
  PENDING
  READY
  ATTACHED
  DELETING
  FAILED
}

enum StorageProvider {
  CLOUDFLARE_R2
}

enum AudioAnalysisStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MediaProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  SET
  COMPILATION
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  REPOST
  PLAYLIST_ADD
  SYSTEM
}

enum NotificationEntityType {
  USER
  TRACK
  RELEASE
  PLAYLIST
  COMMENT
}

model User {
  id                String           @id
  name              String
  email             String           @unique
  emailVerified     Boolean
  image             String?
  bio               String?          @db.Text
  location          String?
  website           String?
  bannerUrl         String?
  profileViews      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          Session[]
  accounts          Account[]
  mediaAssets       MediaAsset[]
  tracks            Track[]
  releases          Release[]
  playlists         Playlist[]
  comments          Comment[]
  commentLikes      CommentLike[]
  trackLikes        TrackLike[]
  releaseLikes      ReleaseLike[]
  playlistLikes     PlaylistLike[]
  trackReposts      TrackRepost[]
  releaseReposts    ReleaseRepost[]
  playlistReposts   PlaylistRepost[]
  followers         Follow[]         @relation("followedUser")
  following         Follow[]         @relation("followingUser")
  playEvents        PlayEvent[]
  notifications     Notification[]   @relation("notificationRecipient")
  sentNotifications Notification[]   @relation("notificationActor")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model MediaAsset {
  id                  String                 @id @default(uuid())
  ownerId             String
  owner               User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind                MediaKind
  status              MediaStatus            @default(PENDING)
  provider            StorageProvider        @default(CLOUDFLARE_R2)
  bucket              String
  storageKey          String                 @unique
  originalFilename    String
  mimeType            String
  byteSize            BigInt?
  publicUrl           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  uploadedAt          DateTime?
  attachedAt          DateTime?
  expiresAt           DateTime?
  audioTrack          Track?                 @relation("trackAudio")
  trackArtwork        Track[]                @relation("trackArtwork")
  releaseArtwork      Release[]              @relation("releaseArtwork")
  playlistArtwork     Playlist[]             @relation("playlistArtwork")
  audioAnalysis       AudioAnalysis?         @relation("analysisAudioAsset")
  processingJob       MediaProcessingJob?    @relation("processingJobAudioAsset")
  detailWaveformFor   AudioAnalysis?         @relation("analysisDetailWaveform")
  overviewWaveformFor AudioAnalysis?         @relation("analysisOverviewWaveform")
  processingErrors    MediaProcessingError[]

  @@index([ownerId, status, expiresAt])
  @@index([kind, status])
  @@map("media_asset")
}

model AudioAnalysis {
  id                      String              @id @default(uuid())
  audioAssetId            String              @unique
  audioAsset              MediaAsset          @relation("analysisAudioAsset", fields: [audioAssetId], references: [id], onDelete: Cascade)
  status                  AudioAnalysisStatus @default(QUEUED)
  durationMs              Int?
  sampleRate              Int?
  channels                Int?
  codec                   String?
  bitRate                 BigInt?
  waveformVersion         Int                 @default(1)
  detailPixelsPerSecond   Int                 @default(100)
  overviewPixelsPerSecond Int                 @default(20)
  waveformBits            Int                 @default(8)
  detailWaveformAssetId   String?             @unique
  detailWaveformAsset     MediaAsset?         @relation("analysisDetailWaveform", fields: [detailWaveformAssetId], references: [id], onDelete: SetNull)
  overviewWaveformAssetId String?             @unique
  overviewWaveformAsset   MediaAsset?         @relation("analysisOverviewWaveform", fields: [overviewWaveformAssetId], references: [id], onDelete: SetNull)
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([status, updatedAt])
  @@map("audio_analysis")
}

model MediaProcessingJob {
  id           String                   @id @default(uuid())
  audioAssetId String                   @unique
  audioAsset   MediaAsset               @relation("processingJobAudioAsset", fields: [audioAssetId], references: [id], onDelete: Cascade)
  status       MediaProcessingJobStatus @default(QUEUED)
  attempts     Int                      @default(0)
  maxAttempts  Int                      @default(3)
  availableAt  DateTime                 @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  lastError    String?                  @db.Text
  finishedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, availableAt, createdAt])
  @@map("media_processing_job")
}

model Track {
  id               String                 @id @default(uuid())
  creatorId        String
  creator          User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  audioAssetId     String                 @unique
  audioAsset       MediaAsset             @relation("trackAudio", fields: [audioAssetId], references: [id], onDelete: Restrict)
  artworkAssetId   String?
  artworkAsset     MediaAsset?            @relation("trackArtwork", fields: [artworkAssetId], references: [id], onDelete: SetNull)
  title            String
  description      String?                @db.Text
  visibility       Visibility             @default(PUBLIC)
  isOriginal       Boolean                @default(true)
  genre            String?
  bpm              Int?
  musicalKey       String?
  tags             String[]               @default([])
  releaseDate      DateTime?
  recordLabel      String?
  playCount        Int                    @default(0)
  downloadCount    Int                    @default(0)
  likeCount        Int                    @default(0)
  repostCount      Int                    @default(0)
  commentCount     Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  releaseEntries   ReleaseTrack[]
  playlistEntries  PlaylistTrack[]
  comments         Comment[]
  likes            TrackLike[]
  reposts          TrackRepost[]
  playEvents       PlayEvent[]
  processingErrors MediaProcessingError[]

  @@index([creatorId, createdAt])
  @@index([visibility, createdAt])
  @@index([genre])
  @@map("track")
}

model Release {
  id             String          @id @default(uuid())
  creatorId      String
  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  artworkAssetId String?
  artworkAsset   MediaAsset?     @relation("releaseArtwork", fields: [artworkAssetId], references: [id], onDelete: SetNull)
  title          String
  description    String?         @db.Text
  type           ReleaseType     @default(SET)
  visibility     Visibility      @default(PUBLIC)
  releaseDate    DateTime?
  playCount      Int             @default(0)
  likeCount      Int             @default(0)
  repostCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tracks         ReleaseTrack[]
  likes          ReleaseLike[]
  reposts        ReleaseRepost[]

  @@index([creatorId, createdAt])
  @@index([visibility, releaseDate])
  @@map("release")
}

model ReleaseTrack {
  id        String   @id @default(uuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())

  @@unique([releaseId, trackId])
  @@unique([releaseId, position])
  @@index([trackId])
  @@map("release_track")
}

model Playlist {
  id              String           @id @default(uuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  artworkAssetId  String?
  artworkAsset    MediaAsset?      @relation("playlistArtwork", fields: [artworkAssetId], references: [id], onDelete: SetNull)
  title           String
  description     String?          @db.Text
  visibility      Visibility       @default(PUBLIC)
  isCollaborative Boolean          @default(false)
  playCount       Int              @default(0)
  likeCount       Int              @default(0)
  repostCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tracks          PlaylistTrack[]
  likes           PlaylistLike[]
  reposts         PlaylistRepost[]

  @@index([ownerId, createdAt])
  @@index([visibility, createdAt])
  @@map("playlist")
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int
  addedById  String?
  createdAt  DateTime @default(now())

  @@unique([playlistId, trackId])
  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_track")
}

model Comment {
  id               String        @id @default(uuid())
  authorId         String
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  trackId          String
  track            Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           Comment?      @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]     @relation("commentReplies")
  content          String        @db.Text
  timestampSeconds Int?
  likeCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  likes            CommentLike[]

  @@index([trackId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("comment")
}

model CommentLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
  @@map("comment_like")
}

model TrackLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([trackId])
  @@map("track_like")
}

model ReleaseLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, releaseId])
  @@index([releaseId])
  @@map("release_like")
}

model PlaylistLike {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, playlistId])
  @@index([playlistId])
  @@map("playlist_like")
}

model TrackRepost {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@index([trackId])
  @@map("track_repost")
}

model ReleaseRepost {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, releaseId])
  @@index([releaseId])
  @@map("release_repost")
}

model PlaylistRepost {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, playlistId])
  @@index([playlistId])
  @@map("playlist_repost")
}

model Follow {
  followerId  String
  follower    User     @relation("followingUser", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("followedUser", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follow")
}

model PlayEvent {
  id              String   @id @default(uuid())
  listenerId      String?
  listener        User?    @relation(fields: [listenerId], references: [id], onDelete: SetNull)
  trackId         String
  track           Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  listenedSeconds Int      @default(0)
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([listenerId, createdAt])
  @@index([trackId, createdAt])
  @@map("play_event")
}

model Notification {
  id          String                  @id @default(uuid())
  recipientId String
  recipient   User                    @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?                   @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  entityType  NotificationEntityType?
  entityId    String?
  message     String
  readAt      DateTime?
  createdAt   DateTime                @default(now())

  @@index([recipientId, readAt, createdAt])
  @@map("notification")
}

model MediaProcessingError {
  id        String      @id @default(uuid())
  trackId   String?
  track     Track?      @relation(fields: [trackId], references: [id], onDelete: SetNull)
  assetId   String?
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  requestId String?
  operation String
  reason    String      @db.Text
  createdAt DateTime    @default(now())

  @@index([trackId, createdAt])
  @@index([assetId, createdAt])
  @@map("media_processing_error")
}
