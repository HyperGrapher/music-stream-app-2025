{
  "name": "music-stream-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:r2": "tsx prisma/seed-r2.ts",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "db:generate": "prisma generate",
    "test:integration": "node --import tsx --import ./tests/integration/setup.ts --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; fi && next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@hookform/resolvers": "^7.0.9",
    "@neon/config": "^1.14.7",
    "@neon/env": "^2.1.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.31.3",
    "@trpc/react-query": "^11.31.3",
    "@trpc/server": "^11.31.3",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sanitize-filename": "^1.6.5",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.7",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "effect": "^3.22.1"
    }
  }
}
