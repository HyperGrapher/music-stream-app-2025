{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:r2": "tsx prisma/seed-r2.ts",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test:upload-lifecycle": "node --import tsx --test src/server/api/routers/upload-lifecycle.test.ts",
    "test:waveform": "node --import tsx --test src/lib/waveform-utils.test.ts",
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test src/server/api/routers/upload-lifecycle.test.ts src/lib/waveform-utils.test.ts src/server/modules/tracks/access.test.ts"
  },
