// SoundCloud-like Database Schema with Prisma ORM

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Core User model
model User {
    id              String   @id @default(uuid())
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    email           String   @unique
    username        String   @unique
    password        String
    name            String?
    bio             String?  @db.Text
    location        String?
    profileImageUrl String?
    headerImageUrl  String?
    isVerified      Boolean  @default(false)

    // User content
    tracks    Track[]
    albums    Album[]
    playlists Playlist[]

    // Social features
    followers Follow[]  @relation("follower")
    following Follow[]  @relation("following")
    comments  Comment[]
    likes     Like[]
    reposts   Repost[]

    // Activity and listening history
    playHistory       PlayHistory[]
    notifications     Notification[] @relation("recipient")
    sentNotifications Notification[] @relation("sender")

    // User analytics
    profileViews Int @default(0)

    @@index([username])
    @@index([email])
}

// Music Track model
model Track {
    id          String   @id @default(uuid())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    title       String
    description String?  @db.Text

    // Audio file details
    audioUrl     String
    duration     Int // Duration in seconds
    waveformData String? @db.Text // JSON string of waveform data points
    isOriginal   Boolean @default(true)
    isPrivate    Boolean @default(false)

    // Track metadata
    genre       String?
    subGenre    String?
    bpm         Int?
    key         String? // Musical key
    tags        String? // Comma-separated tags
    releaseDate DateTime?
    recordLabel String?

    // Cover art
    artworkUrl String?

    // Stats
    playCount     Int @default(0)
    downloadCount Int @default(0)
    likeCount     Int @default(0)
    repostCount   Int @default(0)
    commentCount  Int @default(0)

    // Relationships
    userId  String
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    albumId String?
    album   Album?  @relation(fields: [albumId], references: [id])

    // Track features
    comments    Comment[]
    likes       Like[]
    reposts     Repost[]
    playHistory PlayHistory[]

    // Track in playlists
    playlistTracks PlaylistTrack[]

    @@index([userId])
    @@index([genre])
    @@index([isPrivate])
}

// Album/Set model
model Album {
    id          String    @id @default(uuid())
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    title       String
    description String?   @db.Text
    artworkUrl  String?
    releaseDate DateTime?
    type        AlbumType @default(SET)
    isPrivate   Boolean   @default(false)

    // Stats
    playCount   Int @default(0)
    likeCount   Int @default(0)
    repostCount Int @default(0)

    // Relationships
    userId String
    user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    tracks Track[]

    // Album features
    likes   Like[]
    reposts Repost[]

    @@index([userId])
    @@index([type])
}

enum AlbumType {
    ALBUM
    EP
    SINGLE
    SET
    COMPILATION
}

// Playlist model
model Playlist {
    id              String   @id @default(uuid())
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    title           String
    description     String?  @db.Text
    artworkUrl      String?
    isPrivate       Boolean  @default(false)
    isCollaborative Boolean  @default(false)

    // Stats
    playCount   Int @default(0)
    likeCount   Int @default(0)
    repostCount Int @default(0)

    // Relationships
    userId String
    user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    tracks PlaylistTrack[]

    // Playlist features
    likes   Like[]
    reposts Repost[]

    @@index([userId])
    @@index([isPrivate])
}

// Join table for playlists and tracks with position
model PlaylistTrack {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    position  Int

    // Relationships
    playlistId String
    playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
    trackId    String
    track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

    @@unique([playlistId, trackId])
    @@index([playlistId])
    @@index([trackId])
}

// Comment model
model Comment {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    content   String   @db.Text

    // Optional timestamp for track comments (in seconds)
    timestampSeconds Int?

    // Relationships
    userId  String
    user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    trackId String
    track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

    // Comment stats
    likeCount Int @default(0)

    @@index([userId])
    @@index([trackId])
}

// Like model (polymorphic)
model Like {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())

    // Polymorphic relationship
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Optional relationships - one must be set
    trackId    String?
    track      Track?    @relation(fields: [trackId], references: [id], onDelete: Cascade)
    playlistId String?
    playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)
    albumId    String?
    album      Album?    @relation(fields: [albumId], references: [id], onDelete: Cascade)

    @@unique([userId, trackId])
    @@unique([userId, playlistId])
    @@unique([userId, albumId])
    @@index([userId])
    @@index([trackId])
    @@index([playlistId])
    @@index([albumId])
}

// Repost model (polymorphic)
model Repost {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())

    // Polymorphic relationship
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Optional relationships - one must be set
    trackId    String?
    track      Track?    @relation(fields: [trackId], references: [id], onDelete: Cascade)
    playlistId String?
    playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)
    albumId    String?
    album      Album?    @relation(fields: [albumId], references: [id], onDelete: Cascade)

    @@unique([userId, trackId])
    @@unique([userId, playlistId])
    @@unique([userId, albumId])
    @@index([userId])
    @@index([trackId])
    @@index([playlistId])
    @@index([albumId])
}

// Follow relationship
model Follow {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())

    // Relationships
    followerId  String
    follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
    followingId String
    following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

    @@unique([followerId, followingId])
    @@index([followerId])
    @@index([followingId])
}

// PlayHistory model for listen history
model PlayHistory {
    id            String   @id @default(uuid())
    createdAt     DateTime @default(now())
    completedPlay Boolean  @default(false) // Whether user listened to significant portion

    // Relationships
    userId  String
    user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    trackId String
    track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([trackId])
    @@index([createdAt])
}

// Notification model
model Notification {
    id        String           @id @default(uuid())
    createdAt DateTime         @default(now())
    read      Boolean          @default(false)
    type      NotificationType
    message   String

    // Optional link/reference
    referenceId   String? // ID of the referenced object
    referenceType String? // Type of referenced object (e.g., "track", "comment")

    // Relationships
    recipientId String
    recipient   User    @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
    senderId    String?
    sender      User?   @relation("sender", fields: [senderId], references: [id], onDelete: SetNull)

    @@index([recipientId])
    @@index([read])
}

enum NotificationType {
    FOLLOW
    LIKE
    COMMENT
    REPOST
    PLAYLIST_ADD
    DIRECT_MESSAGE
    SYSTEM
}

model TrackOld {
    id                 String   @id
    name               String
    description        String   @db.Text
    slug               String
    user_id            String
    playlist_url       String? // url check ?in= https://soundcloud.com/propellerrecordings/slotface-indoor-kid?in=propellerrecordings/sets/slotface-2022-2023
    album              String?
    genre              String?
    artwork            String? // url
    permalink          String // full url
    filepath           String // for local dev
    public             Boolean  @default(true)
    commentable        Boolean  @default(true)
    downloadable       Boolean  @default(false)
    downloads          Int      @default(0)
    likes              Int      @default(0)
    playbacks          Int      @default(0)
    playbacks_on_close Int      @default(0) // audioStream.on("close")
    comments           Int      @default(0)
    duration           Int      @default(0)
    releasedBy         String?
    dateRelease        DateTime @default(now())
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([id, name])
    @@map("track_old")
}
